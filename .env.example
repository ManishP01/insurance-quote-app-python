# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# SSL Configuration for Corporate Networks
# Option 1: Use custom certificate bundle (recommended)
REQUESTS_CA_BUNDLE=/path/to/your/certificates.pem

# Option 2: Disable SSL verification (less secure fallback)
DISABLE_SSL_VERIFY=false

# Note: If REQUESTS_CA_BUNDLE is set and file exists, it will be used.
# Otherwise, DISABLE_SSL_VERIFY will be checked as fallback.
